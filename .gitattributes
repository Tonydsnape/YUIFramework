# Normalize repository text files while preserving binary resources.
* text=auto
.gitattributes text eol=lf
.gitignore     text eol=lf

# Source and configuration files.
*.cs          text eol=lf
*.cginc       text eol=lf
*.hlsl        text eol=lf
*.shader      text eol=lf
*.shadergraph text eol=lf
*.json        text eol=lf
*.xml         text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.txt         text eol=lf
*.md          text eol=lf

# Unity YAML assets. UnityYAMLMerge also requires SmartMerge configuration
# on each development machine.
*.meta       text eol=lf
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.anim       text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge

# Git LFS managed binary resources.
*.png   filter=lfs diff=lfs merge=lfs -text
*.bytes filter=lfs diff=lfs merge=lfs -text

# Textures.
*.tga  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text

# Audio.
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text

# Models, video, and fonts.
*.fbx filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Runtime payloads under StreamingAssets use LFS by default.
Assets/StreamingAssets/** filter=lfs diff=lfs merge=lfs -text

# Keep Unity metadata and inspectable configuration files as regular text.
Assets/StreamingAssets/**/*.meta       !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.json       !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.properties !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.lock       !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.manifest   !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.gradle     !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.html       !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.txt        !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.xml        !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.csv        !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.yaml       !filter !diff !merge text eol=lf
Assets/StreamingAssets/**/*.yml        !filter !diff !merge text eol=lf
